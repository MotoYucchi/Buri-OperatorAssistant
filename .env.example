# Call Assist AI - 環境変数設定
PORT=8080

# Gemini API Key (Google AI Studio または Google Cloud Console で取得)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 使用するGeminiモデル (最新のFlashモデルを推奨)
# 例: gemini-3.7-flash, gemini-3.6-flash, gemini-3.5-flash
GEMINI_MODEL=gemini-3.7-flash

# Google Cloud Speech-to-Text API Key
GOOGLE_SPEECH_API_KEY=
